rted(set(roots), key=lambda p: (len(p.parts), str(p)))\n33|    roots = [p for p in roots if not any(q in p.parents for q in roots)]\n34|    if not roots:\n35|        raise ValueError(&#39;at least one root is required&#39;)\n36|    output = Path(output).expanduser()\n37|    if output.exists() or output.is_symlink():\n38|        raise ValueError(&#39;output already exists; select a new report directory&#39;)\n39|    output = output.resolve()\n40|    if any(output == p or p in output.parents for p in roots):\n41|        raise ValueError(&#39;output must be outside every scan root&#39;)\n42|\n43|    source = Path(__file__).with_name(&#39;doc-source-enriched.py&#39;)\n44|    spec = importlib.util.spec_from_file_location(&#39;enriched_v1_engine&#39;, source)\n45|    if spec is None or spec.loader is None:\n46|        raise ValueError(&#39;cannot load sibling enrichment engine&#39;)\n47|    engine = importlib.util.module_from_spec(spec)\n48|    spec.loader.exec_module(engine)\n49|    setattr(engine, &#39;QUIET_MODE&#39;, True)\n50|    rows = engine.scan_and_enrich([str(p) for p in roots])\n51|    # Do NOT call annotate_duplicates: it creates the quadratic path-list payload.\n52|    counts = Counter(r[&#39;content_hash&#39;] for r in rows if r.get(&#39;content_hash&#39;))\n53|    for row in rows:\n54|        path = Path(row.pop(&#39;full_path&#39;))\n55|        index = next(i for i, root in enumerate(roots) if root in path.parents)\n56|        row.pop(&#39;original_path&#39;, None)\n57|        for field in (&#39;duplicate_paths&#39;, &#39;duplicate_group&#39;, &#39;duplicate_count&#39;,\n58|                      &#39;duplicate_basis&#39;, &#39;same_filename_in_group&#39;):\n59|            row.pop(field, None)\n60|        row[&#39;schema_version&#39;] = &#39;2.0&#39;\n61|        row[&#39;root_id&#39;] = f&#39;root-{index + 1}&#39;\n62|        row[&#39;relative_path&#39;] = str(path.relative_to(roots[index]))\n63|        digest = row.get(&#39;content_hash&#39;, &#39;&#39;)\n